# https://github.com/haskell/haskeline/wiki/UserPreferences
maxHistorySize: Nothing
historyDuplicates: IgnoreConsecutive
completionPromptLimit: Just 250
bellStyle: NoBell

# https://github.com/haskell/haskeline/wiki/CustomKeyBindings
bind: { { } left
bind: ( ( ) left
bind: [ [ ] left
bind: } right
bind: ] right
bind: ) right
