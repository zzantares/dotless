-- Build a source map so that other commands like :locate work
:set +c

-- Turn off output for resource usage and types. This is to reduce verbosity when reloading this file.
:unset +s +t

-- Turn on multi-line input and remove the distracting verbosity.
:set +m -v0

-- Turn off all compiler warnings and turn on extension for interactive input.
:seti -w -XOverloadedStrings

-- A nice lambda at the prompt
:set prompt "\ESC[34mλ> \ESC[m"

-- Use emacsclient as the external editor and fallback to nvim
:set editor emacsclient -ct -a nvim

-- Use :rr to reload this .ghci file
:def! rr \_ -> return ":script .ghci"

-- To make sure that laziness  doesn't bite us due to printing results of statements
:set -fno-print-bind-result

-- Search hoogle and view docs given a symbol
let ghciEscapeShellArg arg = "'" ++ concatMap (\c -> if c == '\'' then "'\"'\"'" else [c]) arg ++ "'"

:def! search return . (":! hoogle --count=15 --color " ++) . ghciEscapeShellArg
:def! docs return . (":! hoogle --count=15 --color --info " ++) . ghciEscapeShellArg

