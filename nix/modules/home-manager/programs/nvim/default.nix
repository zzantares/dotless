{
  profile,
  config,
  lib,
  ...
}:

let
  cfg = config.dotless.editors.nvim;

  # dotless's Lua tree, prepended to the runtimepath by the generated init.lua:
  # `require("dotless.*")` resolves from it, and so do its `lsp/`, `ftplugin/`
  # and `colors/` files. Never linked into ~/.config/nvim.
  rtp = ./../../../../../config/nvim;

  # The pieces the generated init.lua requires, in order.
  moduleNames = [
    "colorscheme"
    "options"
    "keymap"
    "diagnostics"
    "statusline"
    "lazy"
    "lsp"
    "format-on-save"
    "filetypes"
    "opentofu-syntax"
  ];

  # One lazy.nvim spec file each, under lua/dotless/plugins.
  pluginNames = [
    "base"
    "fzf-lua"
    "mini"
    "none-ls"
    "octo"
    "treesitter"
  ];

  enabledModules = lib.filter (name: cfg.modules.${name}.enable) moduleNames;
  enabledPlugins = lib.filter (name: cfg.plugins.${name}.enable) pluginNames;

  specs =
    map (name: ''{ import = "dotless.plugins.${name}" }'') enabledPlugins ++ cfg.lazy.extraSpecs;

  lazySetup = lib.concatStringsSep "\n" (
    [
      ''require("dotless.lazy").setup({''
      "\tspec = {"
    ]
    ++ map (spec: "\t\t${spec},") specs
    ++ [
      "\t},"
      "})"
    ]
  );

  lspSetup = lib.concatStringsSep "\n" (
    [
      ''require("dotless.lsp").setup({''
      "\tservers = {"
    ]
    ++ map (server: "\t\t\"${server}\",") cfg.lsp.servers
    ++ [
      "\t},"
      "})"
    ]
  );

  setupCall =
    name:
    {
      lazy = lazySetup;
      lsp = lspSetup;
    }
    .${name} or ''require("dotless.${name}").setup()'';

  header = ''
    -- Generated by dotless: nix/modules/home-manager/programs/nvim.
    -- The pieces come from dotless.editors.nvim. Anything past the requires is
    -- its extraConfig; ~/.config/nvim/after runs later still.'';

  initLua =
    lib.concatStringsSep "\n\n" (
      [
        header
        ''vim.opt.rtp:prepend("${rtp}")''
      ]
      ++ map setupCall enabledModules
      ++ lib.optional (cfg.extraConfig != "") cfg.extraConfig
    )
    + "\n";

  # Per-item live-override convention (mirrors claude-code). Each relative path
  # the consumer lists in profile.liveOverrides.nvim is symlinked live
  # (out-of-store, editable, no rebuild) and dotless stops writing it. The
  # legacy boolean form replaces the whole directory.
  userDir = "${config.home.homeDirectory}/${profile.flakeRoot}/config/nvim";
  live = profile.liveOverrides.nvim or [ ];
  wholeDir = live == true;
  liveItems = if lib.isList live then live else [ ];
  hasLiveItem = rel: builtins.elem rel liveItems;
in
{
  options.dotless.editors.nvim = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Generate ~/.config/nvim/init.lua from dotless's Lua tree.";
    };

    modules = lib.genAttrs moduleNames (name: {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Require dotless's ${name} piece from the generated init.lua.";
      };
    });

    plugins = lib.genAttrs pluginNames (name: {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Pass dotless's ${name} plugin specs to lazy.nvim.";
      };
    });

    lsp.servers = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "lua_ls"
        "jsonls"
        "tofu_ls"
        "nixd"
        "bashls"
      ];
      description = "Servers handed to vim.lsp.enable.";
    };

    lazy = {
      extraSpecs = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        example = [ ''{ import = "mine.plugins" }'' ];
        description = "Lua spec expressions appended to dotless's lazy.nvim spec list.";
      };

      seedLockfile = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Copy dotless's lazy-lock.json in when ~/.config/nvim has none.";
      };
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      example = ''vim.keymap.set("n", "<leader>op", ":Explore<cr>")'';
      description = "Lua appended to the generated init.lua, after dotless's own requires.";
    };
  };

  config = lib.mkIf cfg.enable (
    lib.mkMerge [
      {
        # Keeps the tree require-able even when the consumer replaces init.lua or
        # the whole directory: `vim.opt.rtp:prepend(vim.env.DOTLESS_NVIM_RTP)`.
        home.sessionVariables.DOTLESS_NVIM_RTP = "${rtp}";
      }

      (lib.mkIf wholeDir {
        xdg.configFile."nvim".source = config.lib.file.mkOutOfStoreSymlink userDir;
      })

      (lib.mkIf (!wholeDir) (
        lib.mkMerge [
          (lib.mkIf (!hasLiveItem "init.lua") {
            xdg.configFile."nvim/init.lua".text = initLua;
          })

          {
            # Per-file entries, so ~/.config/nvim stays a writable directory:
            # lazy.nvim writes lazy-lock.json into it and netrw writes .netrwhist.
            xdg.configFile = lib.mkMerge (
              map (rel: {
                "nvim/${rel}".source = config.lib.file.mkOutOfStoreSymlink "${userDir}/${rel}";
              }) liveItems
            );
          }

          (lib.mkIf cfg.lazy.seedLockfile {
            # Seeded, not linked: `:Lazy sync` rewrites it in place afterwards.
            home.activation.nvimLazyLock = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
              lockfile="${config.xdg.configHome}/nvim/lazy-lock.json"
              if [[ ! -e "$lockfile" ]]; then
                mkdir -p "${config.xdg.configHome}/nvim"
                install -m 644 ${rtp}/lazy-lock.json "$lockfile"
              fi
            '';
          })
        ]
      ))
    ]
  );
}
