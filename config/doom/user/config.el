;;; config.el -*- lexical-binding: t; -*-
;; Generated by dotless. The configuration itself lives in the dotless Doom
;; module under modules/config/dotless; this file is the per-user layer, and
;; loads last.

;; Emacs writes this file whenever anything is customized, so it is left
;; unmanaged - a real file in a real directory.
(setq custom-file (concat (file-name-as-directory doom-user-dir)
                          (format "%s-custom.el" user-login-name)))
(load custom-file 'noerror)
